    "db:seed": "dotenv -e .env.local -- tsx db/seed.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.64",
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.1",
